EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_GB
# Optional: lets eBay quote delivery for the buyer's UK area.
EBAY_DELIVERY_POSTCODE=
EBAY_LAPTOP_LIMIT_PER_SEARCH=300
EBAY_LAPTOP_DETAIL_LIMIT=2000
# Detail lookups are sized against the Browse calls left today, keeping this many for the next run.
EBAY_LAPTOP_CALL_RESERVE=1000
# Uncached model requests per run; listings that cannot qualify are never requested.
LAPTOP_AI_MAX_REQUESTS=600
# Server-side only. Used by the explicit offline enrichment command; never exposed to Vite.
OPENAI_API_KEY=
# Optional override for sharing an ignored enrichment cache across worktrees.
LAPTOP_AI_CACHE_PATH=
# Server-side alert delivery. Never expose these through Vite or browser code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAPTOP_DASHBOARD_URL=https://laptopscraper.vercel.app
# GitHub Actions deployment credentials.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
