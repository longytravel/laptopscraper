{
  "name": "laptop-power-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:laptops",
    "test:laptops": "tsx --test tests-js/*.test.ts",
    "collect:laptops": "tsx scripts/collect-laptops.ts",
    "refresh:laptop-benchmarks": "tsx scripts/refresh-benchmark-evidence.ts",
    "enrich:laptops:ai": "tsx scripts/enrich-laptops-ai.ts",
    "evaluate:laptops:ai": "tsx scripts/evaluate-laptop-ai.ts",
    "refresh:laptops": "npm run collect:laptops && npm run enrich:laptops:ai && npm run build",
    "build": "tsc -b && vite build",
    "build:live": "npm run collect:laptops && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "openai": "^6.48.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
